# Copia este archivo como `.env.local` y completa los valores. Nunca subas `.env.local` al repositorio.
#
# URL del proyecto de Supabase (en local: http://127.0.0.1:54321).
VITE_SUPABASE_URL=
# Clave anon / publishable del proyecto. JAMÁS la clave service_role: todo lo que
# empieza por VITE_ termina en el JavaScript que descarga el navegador.
VITE_SUPABASE_ANON_KEY=
