xCell><mxCell id="n1" value="&lt;div style=&quot;font-size:12px;line-height:1.28;color:#263238;font-weight:bold;&quot;&gt;Toca «Reportar»&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;line-height:1.28;color:#546E7A;&quot;&gt;sin sesión, pide iniciar sesión&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;strokeWidth=1.5;shape=label;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135" y="234" width="260" height="70" as="geometry"/></mxCell><mxCell id="n2" value="&lt;div style=&quot;font-size:12px;line-height:1.28;color:#263238;font-weight:bold;&quot;&gt;Toma 1 a 3 fotos&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;line-height:1.28;color:#546E7A;&quot;&gt;comprime a JPEG ≤ 2 MB y borra el EXIF&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;strokeWidth=1.5;shape=label;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135" y="329" width="260" height="70" as="geometry"/></mxCell><mxCell id="n3" value="&lt;div style=&quot;font-size:12px;line-height:1.28;color:#263238;font-weight:bold;&quot;&gt;Ajusta el punto&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;line-height:1.28;color:#546E7A;&quot;&gt;Fused Location · isMock · zona piloto · dirección con Nominatim&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;strokeWidth=1.5;shape=label;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="115" y="424" width="300" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&quot;font-size:12px;line-height:1.28;color:#263238;font-weight:bold;&quot;&gt;Elige categoría y describe&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;line-height:1.28;color:#546E7A;&quot;&gt;10 a 2000 caracteres&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;strokeWidth=1.5;shape=label;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135" y="529" width="260" height="70" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&quot;font-size:12px;line-height:1.28;color:#263238;font-weight:bold;&quot;&gt;Encola y envía&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;line-height:1.28;color:#546E7A;&quot;&gt;Room (PENDIENTE) · WorkManager con red · fotos a Storage&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;strokeWidth=1.5;shape=label;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="115" y="624" width="300" height="80" as="geometry"/></mxCell><mxCell id="d1" value="&lt;div style=&quot;font-size:12px;line-height:1.28;color:#263238;font-weight:bold;&quot;&gt;¿Es el mismo problema?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFC107;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="749" width="230" height="110" as="geometry"/></mxCell><mxCell id="off" value="&lt;div style=&quot;font-size:12px;line-height:1.3;color:#B26A00;&quot;&gt;&lt;b&gt;Sin conexión&lt;/b&gt;&lt;br&gt;el reporte espera en la cola local (Room y WorkManager) y se envía al volver la red. El par (usuario, cliente_id) evita duplicarlo al reintentar.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFF8E1;strokeColor=#FFC107;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="954" width="410" height="96" as="geometry"/></mxCell><mxCell id="n_push" value="&lt;div style=&quot;font-size:12px;line-height:1.28;color:#263238;font-weight:bold;&quot;&gt;Notificación push&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;line-height:1.28;color:#546E7A;&quot;&gt;aviso del nuevo estado; al tocar abre el detalle&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;strokeWidth=1.5;shape=label;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135" y="1451" width="260" height="70" as="geometry"/></mxCell><mxCell id="n_ver" value="&lt;div style=&quot;font-size:12px;line-height:1.28;color:#263238;font-weight:bold;&quot;&gt;«¿Sigue arreglado?»&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;line-height:1.28;color:#546E7A;&quot;&gt;responde si ya está resuelto o si sigue igual&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;strokeWidth=1.5;shape=label;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135" y="1564" width="260" height="70" as="geometry"/></mxCell><mxCell id="s1" value="&lt;div style=&quot;font-size:12px;line-height:1.28;color:#263238;font-weight:bold;&quot;&gt;buscar_duplicados&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;line-height:1.28;color:#546E7A;&quot;&gt;misma categoría, radio y 30 días&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#66BB6A;strokeWidth=1.5;shape=label;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;