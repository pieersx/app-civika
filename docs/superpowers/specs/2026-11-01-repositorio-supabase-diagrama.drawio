<mxGeometry x="40" y="900" width="440" height="64" as="geometry"/></mxCell><mxCell id="c57" value='&lt;b style="font-size:12px"&gt;La RPC no lo devuelve&lt;/b&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#263238;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="900" width="520" height="64" as="geometry"/></mxCell><mxCell id="c58" value='&lt;b style="font-size:12px"&gt;No aparece&lt;/b&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#66BB6A;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#263238;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="900" width="420" height="64" as="geometry"/></mxCell><mxCell id="c59" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#455A64;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="932" as="sourcePoint"/><mxPoint x="500" y="932" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#455A64;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="932" as="sourcePoint"/><mxPoint x="1040" y="932" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value='&lt;b style="font-size:13px"&gt;? Panel web desde otro origen (CORS)&lt;/b&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontColor=#263238;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="978" width="440" height="64" as="geometry"/></mxCell><mxCell id="c62" value='&lt;b style="font-size:12px"&gt;Local: el preflight con los encabezados reales devuelve 200.&lt;br&gt;Navegador real, Supabase Cloud y panel Wasm: sin comprobar&lt;/b&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontColor=#263238;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="978" width="520" height="64" as="geometry"/></mxCell><mxCell id="c63" value='&lt;b style="font-size:12px"&gt;Si falla, el panel muestra Error&lt;/b&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontColor=#263238;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="978" width="420" height="64" as="geometry"/></mxCell><mxCell id="c64" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#455A64;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="1010" as="sourcePoint"/><mxPoint x="500" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c65" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#455A64;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="1010" as="sourcePoint"/><mxPoint x="1040" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c66" value="Rojo = error visible; amarillo = funciona con una limitación; azul = modo de ejemplo; verde = sin problema; gris = sin comprobar. El estado también se dice con texto." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#455A64;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1062" width="1420" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>