a&lt;br&gt;(mín. 0), lat/lon; lo desconocido se omite con aviso&lt;/b&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#263238;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="735" y="1218" width="360" height="56" as="geometry"/></mxCell><mxCell id="c34" value="List&lt;Incidente&gt;" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#90A4AE;strokeWidth=1.6;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=12;fontColor=#263238;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="1312" as="sourcePoint"/><mxPoint x="670" y="1312" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value='&lt;b style="font-size:11px"&gt;Quita Resueltos y Rechazados y ordena&lt;br&gt;con la prioridad del dominio (sin cambios)&lt;/b&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#263238;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="545" y="1350" width="250" height="56" as="geometry"/></mxCell><mxCell id="c36" value="lista priorizada" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#90A4AE;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#263238;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="1444" as="sourcePoint"/><mxPoint x="425" y="1444" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="Continuo = ya existe. Punteado = nuevo o planificado. Flecha gris clara = respuesta. «?» = sin comprobar." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#455A64;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1574" width="1720" height="26" as="geometry"/></mxC