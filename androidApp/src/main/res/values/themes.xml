<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de la Activity una vez pasado el splash. Compose pinta todo; esto solo evita destellos. -->
    <style name="Theme.Civika" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo_ventana</item>
        <item name="android:colorBackground">@color/fondo_ventana</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Civika.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo_ventana</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Civika</item>
    </style>
</resources>
