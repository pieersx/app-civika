# Firma del release. Copia este archivo como `androidApp/keystore.properties` (no se sube al repo).
# Alternativa para el CI: variables ANDROID_KEYSTORE_FILE, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS
# y ANDROID_KEY_PASSWORD. Sin ninguna de las dos, el release se genera sin firmar.
# `storeFile` es relativo a la carpeta androidApp/.
storeFile=civika-release.jks
storePassword=
keyAlias=civika
keyPassword=
